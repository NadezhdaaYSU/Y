// The exact grid-wide sum (`drift_add_to`) as `docs/benchmarks/zero_drift_grid_sum_2026-10-27/`
// wrote it, the same sum with its full rounds in a loop of their own (`zd_split`), and, for
// comparison, the same partition summed in plain f32, each thread's partial stored for a
// second pass.
kernel zd_sum(X: GlobalMemory<F32>, ACC: GlobalMemory<I64>, OUT: GlobalMemory<F32>, P: GlobalMemory<I32>) {
    @ZeroDrift
    @bounds(min=-1000000.0, max=1000000.0)
    let mut acc: F32 = 0.0;
    let t: I32 = thread_idx_x() + block_dim_x() * (thread_idx_y() + block_dim_y() * thread_idx_z());
    let threads: I32 = block_dim_x() * block_dim_y() * block_dim_z();
    let b: I32 = block_idx_x() + grid_dim_x() * (block_idx_y() + grid_dim_y() * block_idx_z());
    let stride: I32 = grid_dim_x() * grid_dim_y() * grid_dim_z() * threads;
    let rounds: I32 = P[0];
    let n: I32 = P[1];
    @invariant(j >= 0)
    for j in 0..rounds step 1 {
        let i: I32 = b * threads + t + j * stride;
        if i < n {
            acc += X[i];
        }
    }
    drift_add_to(ACC, OUT, acc);
}

// zd_sum with the bounds test taken out of the steady loop: P[2] full rounds, where every
// thread's index is below n, then the guarded rounds that remain.
kernel zd_split(X: GlobalMemory<F32>, ACC: GlobalMemory<I64>, OUT: GlobalMemory<F32>, P: GlobalMemory<I32>) {
    @ZeroDrift
    @bounds(min=-1000000.0, max=1000000.0)
    let mut acc: F32 = 0.0;
    let t: I32 = thread_idx_x() + block_dim_x() * (thread_idx_y() + block_dim_y() * thread_idx_z());
    let threads: I32 = block_dim_x() * block_dim_y() * block_dim_z();
    let b: I32 = block_idx_x() + grid_dim_x() * (block_idx_y() + grid_dim_y() * block_idx_z());
    let stride: I32 = grid_dim_x() * grid_dim_y() * grid_dim_z() * threads;
    let rounds: I32 = P[0];
    let n: I32 = P[1];
    let full: I32 = P[2];
    let rest: I32 = rounds - full;
    @invariant(j >= 0)
    for j in 0..full step 1 {
        acc += X[b * threads + t + j * stride];
    }
    @invariant(r >= 0)
    for r in 0..rest step 1 {
        let i: I32 = b * threads + t + (full + r) * stride;
        if i < n {
            acc += X[i];
        }
    }
    drift_add_to(ACC, OUT, acc);
}

kernel f32_partials(X: GlobalMemory<F32>, ACC: GlobalMemory<I64>, OUT: GlobalMemory<F32>, P: GlobalMemory<I32>) {
    let mut acc: F32 = 0.0;
    let t: I32 = thread_idx_x() + block_dim_x() * (thread_idx_y() + block_dim_y() * thread_idx_z());
    let threads: I32 = block_dim_x() * block_dim_y() * block_dim_z();
    let b: I32 = block_idx_x() + grid_dim_x() * (block_idx_y() + grid_dim_y() * block_idx_z());
    let stride: I32 = grid_dim_x() * grid_dim_y() * grid_dim_z() * threads;
    let rounds: I32 = P[0];
    let n: I32 = P[1];
    @invariant(j >= 0)
    for j in 0..rounds step 1 {
        let i: I32 = b * threads + t + j * stride;
        if i < n {
            acc += X[i];
        }
    }
    OUT[b * threads + t] = acc;
}
