.version 7.8
.target sm_89
.address_size 64
.visible .entry remprobe(.param .u64 O)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd0, [O];
    cvta.to.global.u64 %rd1, %rd0;
    mov.u32 %r0, %tid.x;
    rem.u32 %r1, %r0, 4;
    div.u32 %r2, %r0, 4;
    add.u32 %r3, %r1, %r2;
    mul.wide.u32 %rd2, %r0, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
