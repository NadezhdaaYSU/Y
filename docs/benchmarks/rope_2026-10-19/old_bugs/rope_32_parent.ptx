.version 7.8
.target sm_89
.address_size 64

.visible .entry rope_32(
    .param .u64 X_0,
    .param .u64 Positions_1,
    .param .u64 Out_2
)
    // [ADVANCED WARP REGISTER ALLOCATOR] Estimated registers per thread: 21
    // [ADVANCED WARP REGISTER ALLOCATOR] Selected register limit: 32 (to maximize SM occupancy)
    // [ADVANCED WARP REGISTER ALLOCATOR] Estimated occupancy: 100.00% (48 active blocks per SM)
.maxnreg 32
{
    .reg .b32 %r<4>;
    .reg .f32 %f<1>;
    .reg .b64 %rd<8>;
    .reg .pred %p<1>;

    ld.param.u64 %rd0, [X_0];
    ld.param.u64 %rd1, [Positions_1];
    ld.param.u64 %rd2, [Out_2];
    // ========================================================
    // [Y FUSED ROPE] head_dim=32 | 1 warp (32 threads) per row | interleaved pairs, base=10000 | 4-pair vectorized blocks
    // ========================================================
    cvta.to.global.u64 %rd3, %rd0;
    cvta.to.global.u64 %rd4, %rd1;
    cvta.to.global.u64 %rd5, %rd2;
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r2, %r0, 32;
    mul.wide.u32 %rd6, %r0, 4;
    add.s64 %rd7, %rd4, %rd6;
    ld.global.u32 %r3, [%rd7];
    cvt.rn.f32.s32 %f0, %r3;
    // ========================================================
}
