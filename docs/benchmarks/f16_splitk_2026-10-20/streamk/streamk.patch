+/// How a split-K F16 GEMM divides K; see `PtxEmitter::gemm_split_k`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GemmSplit {
+    /// `_splitk<S>`: `%ctaid.z` takes one of S equal K ranges of a tile.
+    Even(u32),
+    /// `_streamk<P>`: P CTAs in `%ctaid.x`, each an equal share of every
+    /// tile's K-steps in turn (`StreamKSchedule`).
+    Stream(u32),
+}
+
+/// A stream-K GEMM's division of work. K is cut into `kblocks` equal
+/// blocks, and unit `v = kb * tiles + t` is output tile t's K-block kb, of
+/// `iters` K-steps; the units are numbered K-block first, `v * iters +
+/// kstep`, and CTA `c` of `ctas` takes the steps `[begin(c), begin(c + 1))`,
+/// `begin(c) = floor(c * total / ctas)`. Its run within one unit is one
+/// piece of that unit; a unit's pieces belong to consecutive CTAs, the first
+/// being `owner(v * iters)`, and piece `c - owner(v * iters)` of unit
+/// `(kb, t)` is written to workspace slot `kb * max_pieces + c -
+/// owner(v * iters)`. Numbering K-blocks first keeps the CTAs that share an
+/// operand within one block's width of each other in K, so the operands they
+/// share are still in L2; numbered tile by tile (one block), CTAs reading
+/// the same A rows sat all along K and 512 x 512 x 65536 read 294 MB from
+/// DRAM where 128 MB is the minimum. Every quantity the kernels compute from
+/// this is below 2^32 (`new` checks), so they use u32 arithmetic.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StreamKSchedule {
+    pub ctas: u32,
+    pub tiles_m: u32,
+    pub tiles_n: u32,
+    pub kblocks: u32,
+    pub iters: u32,
+    pub total: u32,
+    /// The most pieces any unit has.
+    pub max_pieces: u32,
+}
+
+impl StreamKSchedule {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(m: u32, n: u32, k: u32, cta_m: u32, cta_n: u32, cta_k: u32, ctas: u32, kblocks: u32) -> Result<Self, String> {
+        if m % cta_m != 0 || n % cta_n != 0 || k % cta_k != 0 {
+            return Err(format!(
+                "stream K needs whole tiles: {} x {} x {} is not a multiple of the {} x {} x {} tile",
+                m, n, k, cta_m, cta_n, cta_k
+            ));
+        }
+        if kblocks == 0 || (k / cta_k) % kblocks != 0 {
+            return Err(format!("{} K-steps of {} do not cut into {} equal blocks", k / cta_k, cta_k, kblocks));
+        }
+        let (tiles_m, tiles_n, iters) = (m / cta_m, n / cta_n, k / cta_k / kblocks);
+        let total = tiles_m as u64 * tiles_n as u64 * kblocks as u64 * iters as u64;
+        if ctas == 0 || total * (ctas as u64 + 1) >= 1 << 32 {
+            return Err(format!("{} CTAs over {} K-steps overflow the schedule's 32-bit arithmetic", ctas, total));
+        }
+        let mut s = StreamKSchedule { ctas, tiles_m, tiles_n, kblocks, iters, total: total as u32, max_pieces: 0 };
+        s.max_pieces = (0..tiles_m * tiles_n * kblocks).map(|v| s.pieces(v)).max().unwrap_or(1);
+        Ok(s)
+    }
+
+    /// The workspace's M x N slots.
+    pub fn slots(&self) -> u32 {
+        self.kblocks * self.max_pieces
+    }
+
+    /// The first K-step of CTA `c`.
+    pub fn begin(&self, c: u32) -> u32 {
+        (c as u64 * self.total as u64 / self.ctas as u64) as u32
+    }
+
+    /// The CTA whose steps include step `x`: the largest `c` with
+    /// `begin(c) <= x`, which is `ceil((x + 1) * ctas / total) - 1`.
+    pub fn owner(&self, x: u32) -> u32 {
+        (((x as u64 + 1) * self.ctas as u64 + self.total as u64 - 1) / self.total as u64 - 1) as u32
+    }
+
+    /// How many CTAs share unit `v`.
+    pub fn pieces(&self, v: u32) -> u32 {
+        self.owner(v * self.iters + self.iters - 1) - self.owner(v * self.iters) + 1
+    }
+}
