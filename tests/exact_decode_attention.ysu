// Exact decode attention: `y_lang.exact.attention.exact_attention` for one
// query position per sequence, from its quantised operands on, bit for bit.
//
// The Python path runs this as about fifteen kernels a layer (an fp32 matmul
// for the integer scores, the logit, the max, the integer exp2, the sums, the
// V-scale fold, `exact_pv`, the final divide). Here it is one launch: a block
// per (sequence, KV head), one warp per query head of the group, the lanes
// taking key positions 32 at a time. Each chunk of 32 keys is staged in
// shared memory once and read by every query head of the group: K as the
// cache's int16 pairs in padded rows, V as packed bytes transposed so a lane's
// four dimensions of four keys are one 16-byte read. The query is staged as
// packed int8 words, and a score is `dp2a` over the pairs: two int16 x int8
// products and an add per instruction.
//
// Every value is the Python path's, by construction:
//   * scores are integer dot products: |q| <= 127, |k| <= 1023, D <= 128, so
//     every partial sum is an integer below 2^24 - the Python fp32 matmul is
//     exact for that reason, and this I32 sum is exact for any reason;
//   * the logit, the exp argument and the folded weight are float64, one
//     operation per `let`: Y fuses `a * b + c` written in one expression into
//     an FMA, which rounds once where PyTorch rounds twice;
//   * `torch.round` is round-half-to-even, computed as
//     bits(x + 2^52) - bits(2^52) for 0 <= x < 2^30, each operand clamped to
//     [0, 2^30] (the exp argument) or [0, 2^28] (the weight) as the Python code
//     clamps them;
//   * the max of the logits is the max of their order keys (bits with the
//     magnitude flipped for negatives), the same float64 up to the sign of a
//     zero, which only ever makes m - logit +0 where Python's could be -0, and
//     both round to 0;
//   * up to 256 keys, phase 2 reuses phase 1's integer weights p.
//   * `2^28 / safe` is `reciprocal(safe) * 2^28`, which is what PyTorch's
//     `float / tensor` computes (`Tensor.__rdiv__`) - and also equal to the
//     divide, since scaling by a power of two commutes with rounding;
//   * the max, the integer sums and `max` of the folded weights do not depend
//     on order, so the warp reductions give the Python values;
//   * the output is `float32((acc * wscale) / max(l, 1))` in float64.
//
// Random operands almost never land where an operation's ORDER or a tie's
// rounding shows (one in ~10^7 values), so the Python tests add two searched
// cases: one where (s * a) * sk and (s * sk) * a give different exp
// arguments, one where m - logit is exactly k + 0.5 with k even
// (python/y_lang/tests/test_exact_decode_attention.py).
//
// Layout (all contiguous): QI [B][NH][D] (integer-valued float32), A [B][NH]
// (`sq * scaling * log2(e) * 65536`, float64, computed by the caller exactly
// as the Python path does), KP and VP the packed cache rows of
// `y_lang.exact.kv.pack_k` / `pack_v`: KP [B][NKV][T][D + 8] int16, the D
// integers of a K row then its float32 scale's four bytes and padding, read
// here as float32 words (two int16s each, the scale one word); VP
// [B][NKV][T][D + 16] int8, the D integers of a V row then its scale's four
// bytes and padding, read as 32-bit words. BLOCKED [B][T] (1 = masked; not
// read when HAS_MASK is 0, for a batch with no mask at all),
// TABLE [64] (the exp2 table), OUT [B][NH][D].
// Launch: grid (NKV, B), REP warps (REP = NH / NKV <= 8). D is a multiple of
// 16 and at most 128.
kernel exact_decode_attention(
    QI: GlobalMemory<F32>,
    A: GlobalMemory<F64>,
    KP: GlobalMemory<F32>,
    VP: GlobalMemory<U32>,
    BLOCKED: GlobalMemory<I32>,
    TABLE: GlobalMemory<I64>,
    OUT: GlobalMemory<F32>,
    T: I32,
    NH: I32,
    NKV: I32,
    REP: I32,
    D: I32,
    HAS_MASK: I32
) {
    let g: I32 = block_idx_x();
    let b: I32 = block_idx_y();
    let tid: I32 = thread_idx_x();
    let lane: I32 = tid & 31;
    let w: I32 = tid >> 5;
    // Bounded so the strided loops below provably cannot wrap; outside
    // these a launch traps (D <= 128, at most 8 query heads per KV head).
    @bounds(min=1, max=8) let rep: I32 = REP;
    @bounds(min=4, max=32) let dq: I32 = D / 4;
    @bounds(min=2, max=16) let dq8: I32 = D / 8;
    @bounds(min=1, max=8) let dq16: I32 = D / 16;
    // Words in a packed row: K (D + 8) int16s, V D + 16 bytes.
    let kwords: I32 = dq * 2 + 4;
    let vwords: I32 = dq + 4;
    let h: I32 = g * rep + w;
    let kstride: I32 = dq8 + 1;
    let krow0: I32 = (b * NKV + g) * T;
    let qrow: I32 = (b * NH + h) * D;
    // Q as int8 bytes, one row per head: 8 x 8 units of 16 bytes. K, 32 keys
    // a chunk, as int16 pairs in rows of D/8 + 1 sixteen-byte units (the
    // extra unit staggers the rows across the banks). V transposed: unit
    // lane * 9 + j holds the four V words of keys 4j..4j+3 for dimensions
    // 4 * lane .. 4 * lane + 3.
    let sq_s: U64 = shared_alloc_u32(256);
    let sk_s: U64 = shared_alloc_u32(2176);
    let sv_s: U64 = shared_alloc_u32(1152);

    // Q as packed int8 words, one row of D/16 sixteen-byte units per head.
    @invariant(c16 >= 0)
    for c16 in lane..dq16 step 32 {
        let qend: I32 = qrow + D;
        let qa4: F32x4 = block_ptr2d_load_v4(QI, 0, qrow + c16 * 16, 0, 1, qend);
        let qb4: F32x4 = block_ptr2d_load_v4(QI, 0, qrow + c16 * 16 + 4, 0, 1, qend);
        let qc4: F32x4 = block_ptr2d_load_v4(QI, 0, qrow + c16 * 16 + 8, 0, 1, qend);
        let qd4: F32x4 = block_ptr2d_load_v4(QI, 0, qrow + c16 * 16 + 12, 0, 1, qend);
        let wq0: U32 = qa4.x as I32 as U32 & 255;
        let wq1: U32 = qa4.y as I32 as U32 & 255;
        let wq2: U32 = qa4.z as I32 as U32 & 255;
        let wq3: U32 = qa4.w as I32 as U32;
        let wq4: U32 = qb4.x as I32 as U32 & 255;
        let wq5: U32 = qb4.y as I32 as U32 & 255;
        let wq6: U32 = qb4.z as I32 as U32 & 255;
        let wq7: U32 = qb4.w as I32 as U32;
        let wq8: U32 = qc4.x as I32 as U32 & 255;
        let wq9: U32 = qc4.y as I32 as U32 & 255;
        let wqa: U32 = qc4.z as I32 as U32 & 255;
        let wqb: U32 = qc4.w as I32 as U32;
        let wqc: U32 = qd4.x as I32 as U32 & 255;
        let wqd: U32 = qd4.y as I32 as U32 & 255;
        let wqe: U32 = qd4.z as I32 as U32 & 255;
        let wqf: U32 = qd4.w as I32 as U32;
        let pq0: U32 = wq0 | (wq1 << 8) | (wq2 << 16) | (wq3 << 24);
        let pq1: U32 = wq4 | (wq5 << 8) | (wq6 << 16) | (wq7 << 24);
        let pq2: U32 = wq8 | (wq9 << 8) | (wqa << 16) | (wqb << 24);
        let pq3: U32 = wqc | (wqd << 8) | (wqe << 16) | (wqf << 24);
        shared_store_v4(sq_s, w * 8 + c16, pq0, pq1, pq2, pq3);
    }

    let a: F64 = A[b * NH + h];
    let one: F64 = 1.0;
    let zero: F64 = 0.0;
    // Below every logit: -inf, from its bits (computing 1 / 0 took float64's
    // divide slow path in every warp). Python starts its max at the most
    // negative double; the two differ only when every key is masked, and then
    // every weight is forced to 0 whatever the max is.
    let negi: I64 = 0 - 4503599627370496;      // bits(-inf) = 0xFFF0...0, as an I64
    let neg: F64 = f64_from_bits(negi as U64);
    let two52: F64 = 4503599627370496.0;
    let two28: F64 = 268435456.0;
    let inv28: F64 = 0.0000000037252902984619140625;
    // Float64 compares run at 1/64 rate on a GeForce part, so every compare
    // per key is on bits. Non-negative float64s order as their bit patterns
    // (the exp argument m - logit and the weights are >= +0), and for any
    // float64 the key bits ^ ((bits >> 63) & (2^63 - 1)) orders as an I64
    // does (-0 below +0, which keeps m - logit from ever being -0). Bits of
    // 2^30, 2^28 and 2^52; for 0 <= x < 2^52, bits(x + 2^52) - bits(2^52) is
    // x + 2^52 - 2^52, the integer that round-half-even gives.
    let maxpos: I64 = 9223372036854775807;
    let cap30b: U64 = 4742290407621132288;
    let cap28b: U64 = 4733283208366391296;
    let two52b: U64 = 4841369599423283200;
    let chunks: I32 = (T + 31) / 32;
    let kend: I32 = (krow0 + T) * kwords;
    let vend: I32 = (krow0 + T) * vwords;

    // The order key of -inf, bits ^ ((bits >> 63) & (2^63 - 1)).
    let m_key: I64 = 0 - 9218868437227405313;
    let m: F64 = neg;
    let l_lane: I64 = 0;
    let l: I64 = 0;
    let wmax_b: U64 = 0;
    let factor: F64 = zero;
    let wscale: F64 = zero;
    let acc0: I64 = 0;
    let acc1: I64 = 0;
    let acc2: I64 = 0;
    let acc3: I64 = 0;
    // Up to 256 keys, a lane keeps, for its key c * 32 + lane of chunk c,
    // phase 0's float64 logit and phase 1's float64 weight p * sv in
    // registers: phase 1 then neither stages K nor recomputes a dot product,
    // a logit or the key's K scale, and phase 2 neither recomputes p nor
    // reloads the V scale. Past 256 keys every phase recomputes, with the
    // same values: each is the same float64 operations on the same operands.
    // A masked key keeps weight +0, which gives it W = 0 as the mask does.
    let cached: I32 = 0;
    if T <= 256 {
        cached = 1;
    }
    let lg0: F64 = zero;
    let lg1: F64 = zero;
    let lg2: F64 = zero;
    let lg3: F64 = zero;
    let lg4: F64 = zero;
    let lg5: F64 = zero;
    let lg6: F64 = zero;
    let lg7: F64 = zero;
    let wc0: F64 = zero;
    let wc1: F64 = zero;
    let wc2: F64 = zero;
    let wc3: F64 = zero;
    let wc4: F64 = zero;
    let wc5: F64 = zero;
    let wc6: F64 = zero;
    let wc7: F64 = zero;

    @invariant(phase >= 0)
    for phase in 0..3 {
        if phase == 1 {
            let mk: I64 = warp_reduce_max(m_key);
            let mks: I64 = mk >> 63;
            let mkm: I64 = mks & maxpos;
            let mb: I64 = mk ^ mkm;
            let mbu: U64 = mb as U64;
            m = f64_from_bits(mbu);
        }
        if phase == 2 {
            l = warp_reduce_sum(l_lane);
            let wmb: U64 = warp_reduce_max(wmax_b);
            let wmax: F64 = f64_from_bits(wmb);
            let safe_w: F64 = one;
            if wmax > zero {
                safe_w = wmax;
            }
            let recip: F64 = one / safe_w;
            factor = recip * two28;
            wscale = safe_w * inv28;
        }
        @invariant(c >= 0)
        for c in 0..chunks {
            // Every warp is done with the previous chunk before it is replaced.
            barrier_sync();
            let fresh: I32 = 0;
            if phase == 0 {
                fresh = 1;
            }
            if cached == 0 {
                fresh = 1;
            }
            if fresh == 1 {
                @invariant(r >= 0)
                for r in w..32 step rep {
                    let krow: I32 = (krow0 + c * 32 + r) * kwords;
                    // Sixteen bytes, eight int16s, copied as they are.
                    @invariant(k8 >= 0)
                    for k8 in lane..dq8 step 32 {
                        let k8v: F32x4 = block_ptr2d_load_v4(KP, 0, krow + k8 * 4, 0, 1, kend);
                        let fa: F32 = k8v.x;
                        let fb: F32 = k8v.y;
                        let fc: F32 = k8v.z;
                        let fd: F32 = k8v.w;
                        shared_store_v4(sk_s, r * kstride + k8, f32_to_bits(fa), f32_to_bits(fb),
                                        f32_to_bits(fc), f32_to_bits(fd));
                    }
                }
            }
            if phase == 2 {
                @invariant(j4 >= 0)
                for j4 in w..8 step rep {
                    let vrow: I32 = (krow0 + c * 32 + j4 * 4) * vwords;
                    @invariant(wd >= 0)
                    for wd in lane..dq step 32 {
                        let v0: U32 = block_ptr2d_load(VP, 0, vrow + wd, 0, 1, vend);
                        let v1: U32 = block_ptr2d_load(VP, 0, vrow + vwords + wd, 0, 1, vend);
                        let v2: U32 = block_ptr2d_load(VP, 0, vrow + 2 * vwords + wd, 0, 1, vend);
                        let v3: U32 = block_ptr2d_load(VP, 0, vrow + 3 * vwords + wd, 0, 1, vend);
                        shared_store_v4(sv_s, wd * 9 + j4, v0, v1, v2, v3);
                    }
                }
            }
            barrier_sync();

            let t: I32 = c * 32 + lane;
            let wt: I32 = 0;
            if t < T {
                // live: this key's weight wv = p * sv is known and wanted.
                let live: I32 = 0;
                let p: I64 = 0;
                let wv: F64 = zero;
                let reuse: I32 = 0;
                if phase == 2 {
                    reuse = cached;
                }
                if reuse == 1 {
                    let wvc: F64 = wc0;
                    if c == 1 {
                        wvc = wc1;
                    }
                    if c == 2 {
                        wvc = wc2;
                    }
                    if c == 3 {
                        wvc = wc3;
                    }
                    if c == 4 {
                        wvc = wc4;
                    }
                    if c == 5 {
                        wvc = wc5;
                    }
                    if c == 6 {
                        wvc = wc6;
                    }
                    if c == 7 {
                        wvc = wc7;
                    }
                    wv = wvc;
                    live = 1;
                } else {
                    let blocked: I32 = 0;
                    if HAS_MASK != 0 {
                        blocked = BLOCKED[b * T + t];
                    }
                    if blocked == 0 {
                        let logit: F64 = zero;
                        let recall: I32 = 0;
                        if phase == 1 {
                            recall = cached;
                        }
                        if recall == 1 {
                            let lc: F64 = lg0;
                            if c == 1 {
                                lc = lg1;
                            }
                            if c == 2 {
                                lc = lg2;
                            }
                            if c == 3 {
                                lc = lg3;
                            }
                            if c == 4 {
                                lc = lg4;
                            }
                            if c == 5 {
                                lc = lg5;
                            }
                            if c == 6 {
                                lc = lg6;
                            }
                            if c == 7 {
                                lc = lg7;
                            }
                            logit = lc;
                        } else {
                            // Here K is staged (phase 0, or no cache).
                            // Per 16 dimensions: one unit of Q's bytes, two of
                            // K's int16 pairs; dp2a_lo takes bytes 0-1, _hi 2-3.
                            let s: I32 = 0;
                            @invariant(u >= 0)
                            for u in 0..dq16 {
                                let qv: U32x4 = shared_load_v4(sq_s, w * 8 + u);
                                let k0: U32x4 = shared_load_v4(sk_s, lane * kstride + u * 2);
                                let k1: U32x4 = shared_load_v4(sk_s, lane * kstride + u * 2 + 1);
                                let qx: I32 = qv.x as I32;
                                let qy: I32 = qv.y as I32;
                                let qz: I32 = qv.z as I32;
                                let qw: I32 = qv.w as I32;
                                s = dp2a_lo(k0.x as I32, qx, s);
                                s = dp2a_hi(k0.y as I32, qx, s);
                                s = dp2a_lo(k0.z as I32, qy, s);
                                s = dp2a_hi(k0.w as I32, qy, s);
                                s = dp2a_lo(k1.x as I32, qz, s);
                                s = dp2a_hi(k1.y as I32, qz, s);
                                s = dp2a_lo(k1.z as I32, qw, s);
                                s = dp2a_hi(k1.w as I32, qw, s);
                            }
                            let skf: F32 = KP[(krow0 + t) * kwords + dq * 2];
                            let sk: F64 = skf as F64;
                            let sd: F64 = s as F64;
                            let la: F64 = sd * a;
                            logit = la * sk;
                            if cached == 1 {
                                if c == 0 {
                                    lg0 = logit;
                                }
                                if c == 1 {
                                    lg1 = logit;
                                }
                                if c == 2 {
                                    lg2 = logit;
                                }
                                if c == 3 {
                                    lg3 = logit;
                                }
                                if c == 4 {
                                    lg4 = logit;
                                }
                                if c == 5 {
                                    lg5 = logit;
                                }
                                if c == 6 {
                                    lg6 = logit;
                                }
                                if c == 7 {
                                    lg7 = logit;
                                }
                            }
                        }
                        if phase == 0 {
                            let lb: I64 = f64_to_bits(logit) as I64;
                            let ls: I64 = lb >> 63;
                            let lm: I64 = ls & maxpos;
                            let key: I64 = lb ^ lm;
                            if key > m_key {
                                m_key = key;
                            }
                        } else {
                            // tq = clamp(round(m - logit), 0, 2^30); m >= logit,
                            // so x >= +0.
                            let x: F64 = m - logit;
                            let xb: U64 = f64_to_bits(x);
                            let tq: I64 = 1073741824;
                            if xb < cap30b {
                                let up: F64 = x + two52;
                                let ub: U64 = f64_to_bits(up);
                                let tqu: U64 = ub - two52b;
                                tq = tqu as I64;
                            }
                            // p = exp2_neg_q16_16(tq), in int64 (Q0.28).
                            let n: I64 = tq >> 16;
                            let f: I64 = tq & 65535;
                            let idx: I64 = f >> 10;
                            let base: I64 = TABLE[idx as I32];
                            let dd: I64 = f & 1023;
                            let ya: I64 = dd * 744261118;
                            let y: I64 = ya >> 16;
                            let y2a: I64 = y * y;
                            let y2: I64 = y2a >> 30;
                            let y3a: I64 = y2 * y;
                            let y3: I64 = y3a >> 30;
                            let y3b: I64 = y3 * 715827883;
                            let y3o6: I64 = y3b >> 32;
                            let half2: I64 = y2 >> 1;
                            let c1: I64 = 1073741824 - y;
                            let c2: I64 = c1 + half2;
                            let corr: I64 = c2 - y3o6;
                            let gp: I64 = base * corr;
                            let gg: I64 = gp >> 30;
                            let sh: I64 = 2 + n;
                            if sh > 62 {
                                sh = 62;
                            }
                            let shm: I64 = sh - 1;
                            let one64: I64 = 1;
                            let rnd: I64 = one64 << shm;
                            let gr: I64 = gg + rnd;
                            p = gr >> sh;
                            if n >= 30 {
                                p = 0;
                            }
                            live = 1;
                        }
                    }
                }
                if live == 1 {
                    if reuse == 0 {
                        let svb: U32 = VP[(krow0 + t) * vwords + dq];
                        let svf: F32 = f32_from_bits(svb);
                        let sv: F64 = svf as F64;
                        let pf: F64 = p as F64;
                        wv = pf * sv;
                    }
                    // wv >= +0: p >= 0 and the V scale is positive.
                    let wvb: U64 = f64_to_bits(wv);
                    if phase == 1 {
                        l_lane = l_lane + p;
                        if wvb > wmax_b {
                            wmax_b = wvb;
                        }
                        if cached == 1 {
                            if c == 0 {
                                wc0 = wv;
                            }
                            if c == 1 {
                                wc1 = wv;
                            }
                            if c == 2 {
                                wc2 = wv;
                            }
                            if c == 3 {
                                wc3 = wv;
                            }
                            if c == 4 {
                                wc4 = wv;
                            }
                            if c == 5 {
                                wc5 = wv;
                            }
                            if c == 6 {
                                wc6 = wv;
                            }
                            if c == 7 {
                                wc7 = wv;
                            }
                        }
                    } else {
                        // W = clamp(round(w * factor), 0, 2^28).
                        let wf: F64 = wv * factor;
                        let wfb: U64 = f64_to_bits(wf);
                        wt = 268435456;
                        if wfb < cap28b {
                            let up2: F64 = wf + two52;
                            let u2: U64 = f64_to_bits(up2);
                            let wtu: U64 = u2 - two52b;
                            wt = wtu as I32;
                        }
                    }
                }
            }
            if phase == 2 {
                // Every lane adds every key's weighted V row to its own four
                // dimensions, 4 * lane .. 4 * lane + 3; the weight (at most
                // 2^28, an I32) comes from the lane that computed it, and
                // each product is one 32 x 32 -> 64-bit multiply.
                @invariant(j4 >= 0)
                for j4 in 0..8 {
                    let vw: U32x4 = shared_load_v4(sv_s, lane * 9 + j4);
                    let key0: I32 = j4 * 4;
                    let wk0: I32 = shfl_sync_idx(wt, key0);
                    let wk1: I32 = shfl_sync_idx(wt, key0 + 1);
                    let wk2: I32 = shfl_sync_idx(wt, key0 + 2);
                    let wk3: I32 = shfl_sync_idx(wt, key0 + 3);
                    // A key past T has weight 0 (its lane computed none), so
                    // it adds nothing and needs no test.
                    let wx: U32 = vw.x;
                    let wy: U32 = vw.y;
                    let wz: U32 = vw.z;
                    let ww: U32 = vw.w;
                    let xi: I32 = wx as I32;
                    let yi: I32 = wy as I32;
                    let zi: I32 = wz as I32;
                    let wi: I32 = ww as I32;
                    let x0s: I32 = xi << 24;
                    let x1s: I32 = xi << 16;
                    let x2s: I32 = xi << 8;
                    let y0s: I32 = yi << 24;
                    let y1s: I32 = yi << 16;
                    let y2s: I32 = yi << 8;
                    let z0s: I32 = zi << 24;
                    let z1s: I32 = zi << 16;
                    let z2s: I32 = zi << 8;
                    let w0s: I32 = wi << 24;
                    let w1s: I32 = wi << 16;
                    let w2s: I32 = wi << 8;
                    acc0 = acc0 + mul_wide_s32(wk0, x0s >> 24);
                    acc1 = acc1 + mul_wide_s32(wk0, x1s >> 24);
                    acc2 = acc2 + mul_wide_s32(wk0, x2s >> 24);
                    acc3 = acc3 + mul_wide_s32(wk0, xi >> 24);
                    acc0 = acc0 + mul_wide_s32(wk1, y0s >> 24);
                    acc1 = acc1 + mul_wide_s32(wk1, y1s >> 24);
                    acc2 = acc2 + mul_wide_s32(wk1, y2s >> 24);
                    acc3 = acc3 + mul_wide_s32(wk1, yi >> 24);
                    acc0 = acc0 + mul_wide_s32(wk2, z0s >> 24);
                    acc1 = acc1 + mul_wide_s32(wk2, z1s >> 24);
                    acc2 = acc2 + mul_wide_s32(wk2, z2s >> 24);
                    acc3 = acc3 + mul_wide_s32(wk2, zi >> 24);
                    acc0 = acc0 + mul_wide_s32(wk3, w0s >> 24);
                    acc1 = acc1 + mul_wide_s32(wk3, w1s >> 24);
                    acc2 = acc2 + mul_wide_s32(wk3, w2s >> 24);
                    acc3 = acc3 + mul_wide_s32(wk3, wi >> 24);
                }
            }
        }
    }

    // out = float32((acc * wscale) / max(l, 1)), each in float64; lane
    // holds dimensions 4 * lane .. 4 * lane + 3. One divide, for 1 / den,
    // instead of four: q = (acc * wscale) * (1 / den) gives the divide's
    // float32 unless q is within 3 float64 ulps of a float32 rounding
    // midpoint (its low 29 fraction bits within 3 of 2^28), in float32's
    // subnormal range (0 < |q| < 2^-126) or not finite; those divide. The
    // argument is y_lang/exact/norm_kernel.py's: |q - RN64(x / den)| < 3.0001
    // float64 ulps. A searched case where the bare multiply rounds
    // differently is in python/y_lang/tests/test_exact_decode_attention.py;
    // the subnormal and non-finite branches rest on the argument alone (a
    // subnormal case where it matters is too rare to search for).
    if lane < dq {
        let lc: I64 = l;
        if lc < 1 {
            lc = 1;
        }
        let den: F64 = lc as F64;
        let rinv: F64 = one / den;
        let o0a: F64 = acc0 as F64;
        let o0b: F64 = o0a * wscale;
        let o0c: F64 = o0b * rinv;
        let q0b: U64 = f64_to_bits(o0c);
        let q0l: U64 = q0b & 536870911;
        let q0m: U64 = q0b & 9223372036854775807;
        let u0: I32 = 0;
        if q0l >= 268435453 {
            if q0l <= 268435459 {
                u0 = 1;
            }
        }
        if q0m != 0 {
            if q0m < 4039728865751334912 {
                u0 = 1;
            }
        }
        if q0m >= 9218868437227405312 {
            u0 = 1;
        }
        if u0 == 1 {
            o0c = o0b / den;
        }
        let o1a: F64 = acc1 as F64;
        let o1b: F64 = o1a * wscale;
        let o1c: F64 = o1b * rinv;
        let q1b: U64 = f64_to_bits(o1c);
        let q1l: U64 = q1b & 536870911;
        let q1m: U64 = q1b & 9223372036854775807;
        let u1: I32 = 0;
        if q1l >= 268435453 {
            if q1l <= 268435459 {
                u1 = 1;
            }
        }
        if q1m != 0 {
            if q1m < 4039728865751334912 {
                u1 = 1;
            }
        }
        if q1m >= 9218868437227405312 {
            u1 = 1;
        }
        if u1 == 1 {
            o1c = o1b / den;
        }
        let o2a: F64 = acc2 as F64;
        let o2b: F64 = o2a * wscale;
        let o2c: F64 = o2b * rinv;
        let q2b: U64 = f64_to_bits(o2c);
        let q2l: U64 = q2b & 536870911;
        let q2m: U64 = q2b & 9223372036854775807;
        let u2: I32 = 0;
        if q2l >= 268435453 {
            if q2l <= 268435459 {
                u2 = 1;
            }
        }
        if q2m != 0 {
            if q2m < 4039728865751334912 {
                u2 = 1;
            }
        }
        if q2m >= 9218868437227405312 {
            u2 = 1;
        }
        if u2 == 1 {
            o2c = o2b / den;
        }
        let o3a: F64 = acc3 as F64;
        let o3b: F64 = o3a * wscale;
        let o3c: F64 = o3b * rinv;
        let q3b: U64 = f64_to_bits(o3c);
        let q3l: U64 = q3b & 536870911;
        let q3m: U64 = q3b & 9223372036854775807;
        let u3: I32 = 0;
        if q3l >= 268435453 {
            if q3l <= 268435459 {
                u3 = 1;
            }
        }
        if q3m != 0 {
            if q3m < 4039728865751334912 {
                u3 = 1;
            }
        }
        if q3m >= 9218868437227405312 {
            u3 = 1;
        }
        if u3 == 1 {
            o3c = o3b / den;
        }
        let ob: I32 = qrow + lane * 4;
        OUT[ob] = o0c as F32;
        OUT[ob + 1] = o1c as F32;
        OUT[ob + 2] = o2c as F32;
        OUT[ob + 3] = o3c as F32;
    }
}

fn main() {}
