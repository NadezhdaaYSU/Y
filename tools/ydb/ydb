#!/usr/bin/env python3
"""ydb: debugging Y programs as Y, over gdb.

    ydb prog.ysu                      build with -g, then debug it
    ydb prog.ysu -O2                  an optimised debuggable build
    ydb prog.ysu -- arg1 arg2         arguments for the program
    ydb prog.ysu --batch -ex "break scale" -ex run -ex locals
    ydb prog.ysu --gpu 'saxpy<<<1, 32>>>(arange(32), ones(32), 20)'
                                      run a kernel on the GPU, under cuda-gdb

ydb is not a second debugger. It builds the program with `Y -g` - next to its
source, as `Y prog.ysu --debug` does - and starts gdb on it with:

  * the program in gdb's auto-load safe path, so the extension the compiler
    embeds in every `-g` build loads (Y values, Y stack traces);
  * `ydb_gdb.py`, which adds the commands below;
  * the prompt `(ydb) `.

Everything gdb does still works. ydb adds:

  break LOCATION        a Y location: FILE:LINE, LINE, a function, or
                        NAME:LINE where NAME is a file's stem (`kernel` for
                        kernel.ysu) or a function (`scale:14`: line 14 of the
                        file `scale` is in)
  locals                the arguments and locals in scope, with their Y types
  tensor EXPR [COUNT]   a buffer's elements and statistics (an array's length
                        is known; a pointer needs COUNT)
  asm [LINE]            the machine code a line of the running program became
  asm --ptx [LINE]      the PTX a kernel's line became (`Y --emit-ptx --lineinfo`)
  asm --sass [LINE]     the SASS ptxas made of it (at the module's own .target)
  verify [LINE]         what covers a line: what the compiler proved, checked
                        or took on trust there, and what checks the code it
                        became (Rocq proofs, tools/ptxas_tval)

With `--gpu LAUNCH`, ydb debugs a kernel on the GPU instead: it compiles the
program with `Y --emit-ptx -g` (PTX that carries each kernel's variables) and
starts cuda-gdb on `ylaunch.py`, which runs that one launch - see `ylaunch.py`
for LAUNCH's syntax - and prints the buffers afterwards. `break kernel:42`
stops every thread that reaches the line; `locals` and `print` show the
focused thread's values, `cuda thread (5,0,0)` moves the focus, and

  lanes EXPR            EXPR in every lane of the focused warp

shows one value across the warp. The code that runs is the debug build: the
driver compiles `.target ..., debug` PTX without optimisation, so a kernel is
slower than it is without -g, and `verify` says which evidence is about it.

The compiler is this checkout's `target/release/Y` unless `--y` or `$Y_BIN`
names another. It runs in the current directory, so it reads the same
`.ysu_hw_profile` a plain compile there would.
"""
import argparse
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
sys.path.insert(0, HERE)

import ymap  # noqa: E402  (the same compiler discovery the map uses)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    rest = []
    if "--" in argv:
        i = argv.index("--")
        argv, rest = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="ydb", description="Debug a Y program as Y, over gdb.")
    ap.add_argument("program", help="the .ysu source")
    ap.add_argument("-O", dest="opt", choices=["0", "1", "2", "3"], help="optimisation level (default -O0)")
    ap.add_argument("--y", help="the Y compiler to use")
    ap.add_argument("-ex", dest="ex", action="append", default=[], help="a gdb/ydb command to run (repeatable)")
    ap.add_argument("--batch", action="store_true", help="run the -ex commands and exit")
    ap.add_argument("--nx", action="store_true", help="do not read gdb's init files (~/.gdbinit)")
    ap.add_argument("--gpu", metavar="LAUNCH",
                    help="debug a kernel on the GPU under cuda-gdb: KERNEL<<<GRID, BLOCK>>>(ARG, ...)")
    a = ap.parse_args(argv)
    if a.gpu is not None:
        if a.opt is not None or rest:
            print("ydb: --gpu runs one kernel launch: -O and program arguments do not apply", file=sys.stderr)
            return 1
        return gpu(a)

    y = ymap.find_y(a.y)
    if not y:
        print("ydb: no Y compiler: build it (cargo build --release) or pass --y", file=sys.stderr)
        return 1
    gdb = shutil.which("gdb")
    if not gdb:
        print("ydb: no gdb on this machine", file=sys.stderr)
        return 1
    program = os.path.abspath(a.program)
    binary = os.path.splitext(program)[0]
    build = [y, program, "-g", "-o", binary]
    if a.opt is not None:
        build.append("-O" + a.opt)
    run = subprocess.run(build, capture_output=True, text=True)
    static = run.returncode != 0 or not os.path.isfile(binary)
    if static:
        # A program whose kernels use GPU intrinsics does not build for the
        # host at all, so there is no process to debug. The commands that
        # read the GPU compile instead (`asm --ptx`, `asm --sass`) still work,
        # so ydb starts without a program rather than giving up.
        errors = [l for l in (run.stdout + run.stderr).splitlines() if "[!]" in l]
        for l in errors or (run.stdout + run.stderr).splitlines()[-10:]:
            print(l, file=sys.stderr)
        print(
            "ydb: %s does not build for the host, so there is no process to debug.\n"
            "     The GPU commands still work: asm --ptx LINE, asm --sass LINE, verify LINE."
            % os.path.basename(program),
            file=sys.stderr,
        )

    env = dict(os.environ)
    env["YDB_PROGRAM"] = program
    env["YDB_Y"] = y
    env["YDB_CWD"] = os.getcwd()
    if not static:
        env["YDB_HOST"] = "clang -O%s" % (a.opt or "0")
    else:
        env.pop("YDB_HOST", None)
    cmd = [gdb, "-q"] + (["-nx"] if a.nx else []) + [
        "-iex", "set debuginfod enabled off",
        "-iex", "set prompt (ydb) ",
        "-iex", "add-auto-load-safe-path " + binary,
        "-x", os.path.join(HERE, "ydb_gdb.py"),
    ]
    if a.batch:
        cmd.append("-batch")
    for e in a.ex:
        cmd += ["-ex", e]
    if not static:
        cmd += ["--args", binary] + rest
    code = subprocess.call(cmd, env=env)
    return 1 if static and code == 0 and not a.ex else code


def find_cuda_gdb():
    """cuda-gdb: on PATH, or in the CUDA toolkit."""
    found = shutil.which("cuda-gdb")
    if found:
        return found
    for d in (os.environ.get("CUDA_HOME"), os.environ.get("CUDA_PATH"), "/opt/cuda", "/usr/local/cuda"):
        if d and os.path.isfile(os.path.join(d, "bin", "cuda-gdb")):
            return os.path.join(d, "bin", "cuda-gdb")
    return None


def gpu(a):
    """`--gpu LAUNCH`: the kernel's -g PTX, run by ylaunch.py under cuda-gdb."""
    import tempfile

    import ylaunch

    y = ymap.find_y(a.y)
    if not y:
        print("ydb: no Y compiler: build it (cargo build --release) or pass --y", file=sys.stderr)
        return 1
    cgdb = find_cuda_gdb()
    if not cgdb:
        print("ydb: --gpu needs cuda-gdb (the CUDA toolkit's debugger); none on PATH or in "
              "$CUDA_HOME, /opt/cuda, /usr/local/cuda", file=sys.stderr)
        return 1
    program = os.path.abspath(a.program)
    work = tempfile.mkdtemp(prefix="ydb_gpu_")
    try:
        ptx_path = os.path.join(work, os.path.splitext(os.path.basename(program))[0] + ".ptx")
        run = subprocess.run([y, program, "--emit-ptx", "-g", "-o", ptx_path], capture_output=True, text=True)
        if run.returncode != 0 or not os.path.isfile(ptx_path):
            out = (run.stdout + run.stderr).splitlines()
            errors = [l for l in out if "[!]" in l or "[Error]" in l or "rror" in l]
            for l in errors or out[-10:]:
                print(l, file=sys.stderr)
            print("ydb: %s does not compile for the GPU with -g" % os.path.basename(program), file=sys.stderr)
            return 1
        with open(ptx_path) as f:
            ptx = f.read()
        # Checked here, before cuda-gdb starts, so a typo is one line of
        # error rather than a debugging session that launches nothing.
        try:
            ylaunch.parse_launch(a.gpu, ptx)
        except ylaunch.LaunchError as e:
            print("ydb: %s" % e, file=sys.stderr)
            return 1
        env = dict(os.environ)
        env["YDB_PROGRAM"] = program
        env["YDB_Y"] = y
        env["YDB_CWD"] = os.getcwd()
        env["YDB_GPU_PTX"] = ptx_path
        env.pop("YDB_HOST", None)
        cmd = [cgdb, "-q"] + (["-nx"] if a.nx else []) + [
            "-iex", "set debuginfod enabled off",
            "-iex", "set prompt (ydb) ",
            "-iex", "set breakpoint pending on",
            "-x", os.path.join(REPO, "src", "debug_info_gdb.py"),
            "-x", os.path.join(HERE, "ydb_gdb.py"),
        ]
        if a.batch:
            cmd.append("-batch")
        for e in a.ex:
            cmd += ["-ex", e]
        cmd += ["--args", sys.executable, os.path.join(HERE, "ylaunch.py"), ptx_path, a.gpu]
        return subprocess.call(cmd, env=env)
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
